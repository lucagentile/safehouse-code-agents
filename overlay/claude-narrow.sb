;; ---------------------------------------------------------------------------
;; overlay/claude-narrow.sb
;;
;; Append-profile for safehouse-code-agents. Loaded LAST by Safehouse via
;; --append-profile, so the rules below override any earlier allows that
;; Safehouse's base or auto-included integrations granted.
;;
;; What we change vs Safehouse defaults for Claude Code:
;;
;;   1. Re-deny the macOS Keychain. Safehouse auto-includes keychain.sb when
;;      it detects "claude" on the command line, which grants the sandboxed
;;      agent wholesale access to the login keychain (every credential you
;;      have ever saved). We don't want that. The wrapper extracts only the
;;      "Claude Code-credentials" Keychain item BEFORE entering the sandbox
;;      and writes it to ~/.claude/.credentials.json (claude's plaintext
;;      fallback path). Inside the sandbox, only that one token is reachable.
;;
;;   2. Allow ~/.ssh/*.pub reads. With --enable=ssh, Safehouse re-opens the
;;      agent socket but still denies the rest of ~/.ssh, breaking SSH-based
;;      git commit signing (which reads ~/.ssh/id_*.pub to identify which
;;      key the agent should use to sign). Public keys are public by design;
;;      private keys stay denied so signing material never leaks.
;;
;;   3. Cloud-credential hardening. Default-deny already covers these but
;;      Safehouse may have shipped or may later ship integrations that grant
;;      them - belt-and-suspenders.
;;
;; Requires Safehouse >= 0.10.0 (the version that ships the file-ioctl allow
;; for tty/pty paths upstream, via eugene1g/agent-safehouse#98).
;; ---------------------------------------------------------------------------

;; 1) Re-deny Keychain. Last-match-wins, so these denies override the allows
;;    that profiles/55-integrations-optional/keychain.sb emitted earlier.
(deny mach-lookup
    (global-name "com.apple.SecurityServer")
    (global-name "com.apple.security.agent")
    (global-name "com.apple.securityd.xpc")
    (global-name "com.apple.security.authhost")
    (global-name "com.apple.secd")
    (global-name "com.apple.trustd")
)
(deny file-read* file-write*
    (home-subpath "/Library/Keychains")
    (home-literal "/Library/Preferences/com.apple.security.plist")
)
(deny file-read*
    (literal "/Library/Preferences/com.apple.security.plist")
    (literal "/Library/Keychains/System.keychain")
    (subpath "/private/var/db/mds")
)
(deny ipc-posix-shm-read-data ipc-posix-shm-write-create ipc-posix-shm-write-data
    (ipc-posix-name "com.apple.AppleDatabaseChanged")
)

;; 2) SSH public keys for commit signing.
;;    With --enable=ssh, Safehouse re-allows agent socket access but still
;;    denies the broader ~/.ssh/ subpath including .pub files. Git's SSH
;;    commit signing reads ~/.ssh/id_*.pub before handing the signing job
;;    to the agent, so without this it fails with:
;;      error: Couldn't load public key /Users/.../.ssh/id_rsa.pub
;;    Allowing just *.pub keeps private keys denied (defense-in-depth) -
;;    the agent on the host still does the actual signing.
(allow file-read*
    (regex (string-append "^" HOME_DIR "/\\.ssh/[^/]+\\.pub$"))
)

;; 3) Cloud-credential hardening. Explicit even though default-deny covers it.
(deny file-read* file-write*
    (home-subpath "/.aws")
    (home-subpath "/.config/gcloud")
    (home-subpath "/.azure")
)
